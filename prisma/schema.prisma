generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  quizzes   Quiz[]
  createdAt DateTime @default(now())
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  questions   Question[]
  createdAt   DateTime   @default(now())
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  createdAt     DateTime @default(now())
}
