generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Define an Enum to lock down the exact types of quizzes allowed
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  IDENTIFICATION
}

model Quiz {
  id          String     @id @default(uuid())
  title       String
  description String
  createdAt   DateTime   @default(now())
  
  // A one-to-many relationship: One Quiz has many Questions
  questions   Question[]
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  // Categorize the question type using the Enum
  type          QuestionType 
  
  questionText  String
  
  // We use a JSON array to store options. 
  // - Multiple Choice: ["A", "B", "C", "D"]
  // - True/False: ["True", "False"]
  // - Identification: [] (Empty array)
  options       Json         @default("[]")
  
  correctAnswer String
  explanation   String
}
