# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
build/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (CRITICAL: Protects your Prisma Postgres URL)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma specific
*.db
*.db-journal
# Ignore the custom generated clients (they should be generated on the host server, not tracked in git)
/src/generated/prisma
/app/generated/prisma